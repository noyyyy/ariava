{
  "name": "ariava",
  "version": "0.2.1",
  "description": "Live Your Life. Your Agents Stay Close.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/noyyyy/ariava",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noyyyy/ariava.git"
  },
  "bugs": {
    "url": "https://github.com/noyyyy/ariava/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "ariava": "apps/bridge/dist/public-cli.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "apps/bridge/dist",
    "packages/protocol/dist",
    "packages/shared-utils/dist",
    "extensions/pi/bundle"
  ],
  "workspaces": [
    "apps/bridge",
    "extensions/pi",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:protocol && bun run build:shared-utils && bun run build:bridge && bun run build:pi-bundle",
    "build:protocol": "bun run ./scripts/build-public-package.mjs protocol",
    "build:shared-utils": "bun run ./scripts/build-public-package.mjs shared-utils",
    "build:bridge": "node ./scripts/build-bridge.mjs",
    "dev:init": "bun run ./apps/bridge/src/dev-profile-cli.ts init",
    "dev:bridge": "bun run ./apps/bridge/src/dev-profile-cli.ts bridge",
    "dev:pi": "bun run ./apps/bridge/src/dev-profile-cli.ts pi",
    "dev:status": "bun run ./apps/bridge/src/dev-profile-cli.ts status",
    "dev:pair": "bun run ./apps/bridge/src/dev-profile-cli.ts pair",
    "version:bump": "node ./scripts/bump-version.mjs",
    "release:push": "node ./scripts/release-flow.mjs push",
    "release:tag": "node ./scripts/release-flow.mjs tag",
    "release:prepare": "./scripts/publish-npm-safe.sh --prepare",
    "build:pi-bundle": "bun run --cwd extensions/pi build && node ./scripts/build-pi-release-bundle.mjs",
    "package:assert": "node ./scripts/package-assert.mjs",
    "test": "bun run test:shared",
    "test:shared": "bun run build && bun run ./scripts/run-test-lane.mjs shared && bun run --cwd extensions/pi test",
    "test:macos": "bun run ./scripts/run-test-lane.mjs macos",
    "test:linux": "bun run ./scripts/run-test-lane.mjs linux",
    "verify:shared": "bun run test:shared && bun run --cwd extensions/pi typecheck && bun run package:assert",
    "verify:macos": "bun run verify:shared && bun run test:macos",
    "verify:linux": "bun run verify:shared && bun run test:linux",
    "verify:linux:docker": "./scripts/verify-linux-docker.sh",
    "verify:host": "bun run ./scripts/verify-host.mjs",
    "verify": "bun run verify:shared",
    "dev:setup": "npm run build:bridge && node ./apps/bridge/dist/dev-profile-cli.js setup"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  }
}
