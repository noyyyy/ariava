{
  "name": "ariava",
  "version": "0.2.5",
  "description": "Live Your Life. Your Agents Stay Close.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/noyyyy/ariava",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noyyyy/ariava.git"
  },
  "bugs": {
    "url": "https://github.com/noyyyy/ariava/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "ariava": "apps/bridge/dist/public-cli.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "apps/bridge/dist",
    "packages/protocol/dist",
    "packages/shared-utils/dist",
    "extensions/pi/bundle"
  ],
  "workspaces": [
    "apps/bridge",
    "extensions/pi",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run ./scripts/build-public-package.mjs protocol && bun run ./scripts/build-public-package.mjs shared-utils && node ./scripts/build-bridge.mjs && bun run build:pi-bundle",
    "dev:cli": "node ./scripts/build-bridge.mjs && node ./apps/bridge/dist/dev-profile-cli.js",
    "dev:setup": "node ./scripts/build-bridge.mjs && node ./apps/bridge/dist/dev-profile-cli.js setup",
    "version:bump": "node ./scripts/bump-version.mjs",
    "release:push": "node ./scripts/release-flow.mjs push",
    "release:tag": "node ./scripts/release-flow.mjs tag",
    "release:prepare": "./scripts/publish-npm-safe.sh --prepare",
    "build:pi-bundle": "bun run --cwd extensions/pi build && node ./scripts/build-pi-release-bundle.mjs",
    "package:assert": "node ./scripts/package-assert.mjs",
    "test": "bun run build && bun run ./scripts/run-test-lane.mjs shared && node ./scripts/run-node-bridge-tests.mjs && bun run --cwd extensions/pi test",
    "test:macos": "bun run ./scripts/run-test-lane.mjs macos",
    "test:linux": "bun run ./scripts/run-test-lane.mjs linux",
    "verify": "bun run test && bun run --cwd extensions/pi typecheck && bun run package:assert",
    "verify:macos": "bun run verify && bun run test:macos",
    "verify:linux": "bun run verify && bun run test:linux",
    "verify:linux:docker": "./scripts/verify-linux-docker.sh",
    "verify:host": "bun run ./scripts/verify-host.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  }
}
