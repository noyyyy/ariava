# Reviewed multi-platform manifest digest resolved from docker.io/library/node:24.18.0-bookworm-slim.
FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

ARG NODE_VERSION=24.18.0
ARG NPM_VERSION=11.18.0
ARG BUN_VERSION=1.3.14

LABEL io.ariava.verify.base-image="docker.io/library/node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d" \
      io.ariava.verify.node-version="24.18.0" \
      io.ariava.verify.npm-version="11.18.0" \
      io.ariava.verify.bun-version="1.3.14"

RUN test "$(node --version)" = "v${NODE_VERSION}" \
    && npm install --global "npm@${NPM_VERSION}" "bun@${BUN_VERSION}" --registry https://registry.npmjs.org/ \
    && test "$(npm --version)" = "${NPM_VERSION}" \
    && test "$(bun --version)" = "${BUN_VERSION}"

COPY --chmod=0555 scripts/docker/shasum /usr/local/bin/shasum
COPY --chmod=0555 scripts/docker/verify-linux-entrypoint.sh /usr/local/bin/ariava-verify-linux-entrypoint
COPY --chown=node:node . /opt/ariava-source

ENV HOME=/tmp/ariava-home \
    XDG_CONFIG_HOME=/tmp/ariava-home/.config \
    XDG_CACHE_HOME=/tmp/ariava-home/.cache \
    XDG_DATA_HOME=/tmp/ariava-home/.local/share \
    NPM_CONFIG_PREFIX=/tmp/ariava-home/.npm-global \
    NPM_CONFIG_USERCONFIG=/tmp/ariava-home/.npmrc \
    NPM_CONFIG_GLOBALCONFIG=/tmp/ariava-home/global.npmrc \
    BUN_INSTALL_CACHE_DIR=/tmp/ariava-home/.cache/bun/install/cache \
    ARIAVA_VERIFY_BASE_IMAGE=docker.io/library/node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

USER node:node
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/ariava-verify-linux-entrypoint"]
CMD ["bun", "run", "verify:linux"]
